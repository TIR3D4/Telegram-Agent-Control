# Generate real keys with: ./scripts/tacctl install
TAC_BOT_TOKEN=
TAC_OWNER_KEY=
TAC_AGENT_KEY=
TAC_LEGACY_AGENT_KEYS_ENABLED=false
TAC_READER_KEY=
TAC_WEBHOOK_SECRET=
TAC_ALLOWED_CHATS=@your_channel
TAC_DB_PASSWORD=
TAC_DATABASE_URL=postgresql+psycopg://tac:CHANGE_ME@postgres:5432/tac
TAC_STORAGE_DIR=/data/media
TAC_PUBLIC_URL=http://127.0.0.1:8787
TAC_TIMEZONE=Asia/Tehran
TAC_BIND=127.0.0.1
TAC_PORT=8787
TAC_DOMAIN=localhost
TAC_LOG_LEVEL=INFO

# Set automatically by scripts/tacctl setup for managed OAuth, or configure your external provider.
TAC_OAUTH_ISSUER=
TAC_OAUTH_JWKS_URL=
TAC_OAUTH_AUDIENCE=
TAC_OAUTH_MAX_LIFETIME=3600
TAC_APPROVAL_TTL_SECONDS=3600
TAC_APPROVAL_MAX_DAYS=30
TAC_RETENTION_DAYS=90
TAC_WORKER_STALE_SECONDS=90
TAC_MAX_RETRIES=5
TAC_OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.example/v1/traces

# Managed console access; generated by setup, never paste plaintext passwords here.
TAC_OWNER_USERNAME=owner
TAC_OWNER_PASSWORD_HASH=
TAC_OWNER_OAUTH_SUBJECT=
TAC_OAUTH_ADMIN_CLIENT_ID=tac-console
TAC_OAUTH_ADMIN_CLIENT_SECRET=
